<%# app/views/actors/edit.html.erb %>
<h1 class="h3 mb-4">✏️ Редагувати актора</h1>

<div class="card shadow-sm" style="max-width: 480px;">
  <div class="card-body">
    <%= form_with model: [@movie, @actor], local: true do |f| %>
      <% if @actor.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @actor.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :name, "Ім'я актора", class: 'form-label fw-semibold' %>
        <%= f.text_field :name, class: 'form-control' %>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit 'Зберегти', class: 'btn btn-primary' %>
        <%= link_to 'Скасувати', @movie, class: 'btn btn-secondary' %>
      </div>
    <% end %>
  </div>
</div>
