<%# app/views/movies/show.html.erb %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><%= @movie.title %></h1>
  <div class="d-flex gap-2">
    <%= link_to 'Редагувати', edit_movie_path(@movie), class: 'btn btn-outline-secondary' %>
    <%= link_to '← До списку', movies_path, class: 'btn btn-outline-primary' %>
  </div>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <dl class="row mb-0">

      <dt class="col-sm-3">Жанр</dt>
      <dd class="col-sm-9"><%= @movie.genre&.name || '—' %></dd>

      <dt class="col-sm-3">Режисер</dt>
      <dd class="col-sm-9"><%= @movie.director.presence || '—' %></dd>

      <dt class="col-sm-3">Дата виходу</dt>
      <dd class="col-sm-9"><%= @movie.release_date&.strftime('%d.%m.%Y') || '—' %></dd>

      <dt class="col-sm-3">Рейтинг</dt>
      <dd class="col-sm-9"><%= rating_badge(@movie) %></dd>

      <dt class="col-sm-3">Статус</dt>
      <dd class="col-sm-9">
        <span class="badge bg-secondary"><%= @movie.status.humanize %></span>
      </dd>

      <dt class="col-sm-3">Опис</dt>
      <dd class="col-sm-9"><%= @movie.description.presence || '—' %></dd>

    </dl>
  </div>
</div>

<!-- Актори -->
<div class="card shadow-sm mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">🎭 Актори</h5>
  </div>
  <div class="card-body">
    <% if @movie.actors.empty? %>
      <p class="text-muted">Акторів ще немає.</p>
    <% else %>
      <table class="table table-striped align-middle mb-3">
        <thead class="table-dark">
          <tr>
            <th>Ім'я</th>
            <th>Дії</th>
          </tr>
        </thead>
        <tbody>
          <% @movie.actors.each do |actor| %>
            <tr>
              <td><%= actor.name %></td>
              <td>
                <%= link_to 'Редагувати', edit_movie_actor_path(@movie, actor), class: 'btn btn-sm btn-outline-secondary' %>
                <%= link_to 'Видалити', movie_actor_path(@movie, actor),
                      data: { turbo_method: :delete, turbo_confirm: 'Видалити актора?' },
                      class: 'btn btn-sm btn-danger' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <!-- Форма додавання актора -->
    <h6 class="fw-semibold">Додати актора:</h6>
    <%= form_with url: movie_actors_path(@movie), local: true do |f| %>
      <div class="d-flex gap-2">
        <%= f.text_field :name, class: 'form-control', placeholder: "Ім'я актора",
              name: 'actor[name]' %>
        <%= f.submit 'Додати', class: 'btn btn-primary' %>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-3">
  <%= link_to 'Видалити фільм', @movie,
        data: { turbo_method: :delete, turbo_confirm: 'Ви впевнені?' },
        class: 'btn btn-danger' %>
</div>
