<%# app/views/movies/watched.html.erb %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">✅ Переглянуті фільми</h1>
  <%= link_to '← Всі фільми', movies_path, class: 'btn btn-outline-secondary' %>
</div>

<% if @movies.empty? %>
  <div class="alert alert-info">Немає переглянутих фільмів.</div>
<% else %>
  <table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
      <tr>
        <th>Назва</th>
        <th>Жанр</th>
        <th>Режисер</th>
        <th>Рейтинг</th>
        <th>Дії</th>
      </tr>
    </thead>
    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td><strong><%= movie.title %></strong></td>
          <td><%= movie.genre&.name || '—' %></td>
          <td><%= movie.director || '—' %></td>
          <td><%= rating_badge(movie) %></td>
          <td>
            <%= link_to 'Деталі', movie, class: 'btn btn-sm btn-outline-primary' %>
            <%= link_to 'Редагувати', edit_movie_path(movie), class: 'btn btn-sm btn-outline-secondary' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
