<%# app/views/genres/index.html.erb %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">🎭 Жанри</h1>
  <%= link_to '+ Додати жанр', new_genre_path, class: 'btn btn-primary' %>
</div>

<% if @genres.empty? %>
  <div class="alert alert-info">Жанрів ще немає. Додайте перший!</div>
<% else %>
  <table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
      <tr>
        <th>Назва</th>
        <th>Фільмів</th>
        <th>Дії</th>
      </tr>
    </thead>
    <tbody>
      <% @genres.each do |genre| %>
        <tr>
          <td><strong><%= genre.name %></strong></td>
          <td><span class="badge bg-primary"><%= genre.movies.count %></span></td>
          <td>
            <%= link_to 'Редагувати', edit_genre_path(genre), class: 'btn btn-sm btn-outline-secondary' %>
            <%= link_to 'Видалити', genre, data: { turbo_method: :delete, turbo_confirm: 'Видалити жанр?' }, class: 'btn btn-sm btn-danger' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
