<!DOCTYPE html>
<html>
  <head>
    <title>Каталог Фільмів</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- Навігаційна панель -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand fw-bold" href="<%= root_path %>">🎬 CinemaDB</a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item">
              <%= link_to 'Всі фільми', movies_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to 'Переглянуті', watched_movies_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to 'Цього року', released_this_year_movies_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to 'Жанри', genres_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to 'Новий фільм', new_movie_path, class: "nav-link btn btn-outline-light ms-2 px-3" %>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Flash-повідомлення -->
    <div class="container mt-3">
      <% flash.each do |type, message| %>
        <% css = type == 'notice' ? 'alert-success' : 'alert-danger' %>
        <div class="alert <%= css %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
    </div>

    <!-- Основний контент -->
    <main class="container mt-4 mb-5">
      <%= yield %>
    </main>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
